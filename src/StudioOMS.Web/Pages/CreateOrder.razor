@page "/create-order"
@using StudioOMS.Orders.Timing
@inject HttpClient Http

<h3>创建计时订单</h3>

<div>
    <label>客户 ID：</label>
    <input @bind="clientId" />
</div>
<div>
    <label>销售 ID：</label>
    <input @bind="salespersonId" />
</div>
<div>
    <label>总天数：</label>
    <input type="number" @bind="totalDays" />
</div>

<button @onclick="CreateOrderAsync">创建订单</button>

@if (!string.IsNullOrEmpty(message))
{
    <p>@message</p>
}

@code {
    private Guid clientId = Guid.NewGuid();
    private Guid salespersonId = Guid.NewGuid();
    private decimal totalDays = 10;
    private string? message;

    private async Task CreateOrderAsync()
    {
        var dto = new TimingOrderCreateDto()
        {
            OrderId = Guid.NewGuid(),
            ClientId = clientId,
            SalespersonId = salespersonId,
            TotalDays = totalDays
        };

        var response = await Http.PostAsJsonAsync("/api/orders/timing", dto, AppJsonSerializerContext.Default.TimingOrderCreateDto, default);

        if (response.IsSuccessStatusCode)
        {
            var result = await response.Content.ReadAsStringAsync();
            message = $"订单已创建：{result}";
        }
        else
        {
            message = $"创建失败：{response.StatusCode}";
        }
    }

    private sealed record CreateOrderResponse(string OrderId);
}